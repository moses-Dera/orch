# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/orch


# Optional: override the default strong model used for reviews
DEFAULT_STRONG_MODEL=openai/gpt-4o

# ─── RAG / Embeddings ────────────────────────────────────────
# Google Gemini API key — used exclusively for text-embedding-004
# FREE tier: 1,500 requests/day, no credit card required
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Number of constraint chunks to retrieve per request (default: 6)
# RAG_TOP_K=6

# Number of past messages to keep in conversation history (default: 10)
# CHAT_HISTORY_LIMIT=10

# ─── GitHub App ──────────────────────────────────────────────
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ─── Server & Internal Security ──────────────────────────────
PORT=3001
# Must match the ORCH_API_KEY in apps/dashboard
ORCH_API_KEY=orch_your-server-key-here

# ─── Email (Gmail API v1) ────────────────────────────────────
GMAIL_CLIENT_ID=your_oauth_client_id
GMAIL_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
ADMIN_EMAIL=admin@yourcompany.com
